        // Render Home Products Grid
        function renderProducts(itemsToRender = null) {
            const grid = document.getElementById('home-products-grid');
            const list = itemsToRender || (activeCategory === 'all' ? products : products.filter(p => p.category === activeCategory));
            
            grid.innerHTML = '';

            if (list.length === 0) {
                grid.innerHTML = `<div class="col-span-2 text-center py-8 text-slate-400 font-bold text-xs">لا توجد منتجات في هذا القسم حالياً</div>`;
