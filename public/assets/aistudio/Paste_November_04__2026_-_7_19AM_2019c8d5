        // Category Filtering
        function filterCategory(cat) {
            activeCategory = cat;
            document.querySelectorAll('.cat-pill').forEach(btn => {
                btn.classList.remove('bg-purple-600', 'text-white');
                btn.classList.add('bg-white', 'text-slate-700');
            });
            event.target.classList.remove('bg-white', 'text-slate-700');
            event.target.classList.add('bg-purple-600', 'text-white');
            renderProducts();
        }

        function filterCategoryAndSwitch(cat) {
            activeCategory = cat;
            switchTab('home');
            renderProducts();
        }

        // Search Handler
        function handleSearch() {
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            if (!query) {
                renderProducts();
                return;
            }
            const filtered = products.filter(p => p.title.toLowerCase().includes(query) || p.brand.toLowerCase().includes(query));
            renderProducts(filtered);
        }

        // Tab Navigation Switcher
        function switchTab(tabId) {
            // Hide all pages
            ['home', 'categories', 'brands', 'discover', 'more'].forEach(p => {
                document.getElementById(`page-${p}`).classList.add('hidden');
            });

            // Show selected page
            document.getElementById(`page-${tabId}`).classList.remove('hidden');

            // Reset navbar styling
            document.querySelectorAll('.nav-item').forEach(nav => {
                nav.className = 'nav-item flex items-center gap-1.5 text-slate-400 font-bold text-xs hover:text-purple-600 px-2 py-2 rounded-full transition-all';
            });

            // Highlight active nav button
            const activeNav = document.getElementById(`nav-${tabId}`);
            if (activeNav) {
                activeNav.className = 'nav-item flex items-center gap-1.5 text-purple-700 font-black text-xs bg-purple-50 px-3.5 py-2 rounded-full transition-all';
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Cart Logic
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existing = cart.find(item => item.id === productId);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ ...product, qty: 1 });
            }

            saveCart();
            showToast(`تمت إضافة (${product.title}) إلى السلة`);
        }

        function updateCartBadge() {
            const badge = document.getElementById('cart-badge');
            const totalItems = cart.reduce((sum, i) => sum + i.qty, 0);
            if (totalItems > 0) {
                badge.innerText = totalItems;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function openCart() {
            renderCartItems();
            document.getElementById('cart-modal').classList.remove('hidden');
        }

        function closeCart() {
            document.getElementById('cart-modal').classList.add('hidden');
        }

        function renderCartItems() {
            const container = document.getElementById('cart-items-container');
            const totalElem = document.getElementById('cart-total-price');
            container.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-slate-400 font-bold text-xs">
                        <i class="fa-solid fa-basket-shopping text-3xl mb-2 block opacity-40"></i>
                        سلة التسوق فارغة حالياً
                    </div>
                `;
                totalElem.innerText = '0 د.ع';
                return;
            }

            let totalPrice = 0;

            cart.forEach((item, index) => {
                const subtotal = item.price * item.qty;
                totalPrice += subtotal;

                container.innerHTML += `
                    <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-2xl border border-slate-100">
                        <div class="flex items-center gap-2.5">
                            <img src="${item.image}" class="w-12 h-12 object-contain rounded-xl bg-white p-1">
                            <div>
                                <h4 class="font-extrabold text-xs text-slate-800 line-clamp-1">${item.title}</h4>
                                <span class="text-[11px] font-bold text-purple-700">${item.price.toLocaleString()} د.ع</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <div class="flex items-center bg-white rounded-xl border border-slate-200">
                                <button onclick="changeQty(${index}, -1)" class="w-7 h-7 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-r-xl">-</button>
                                <span class="text-xs font-extrabold px-2 text-slate-800">${item.qty}</span>
                                <button onclick="changeQty(${index}, 1)" class="w-7 h-7 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-l-xl">+</button>
                            </div>
                            <button onclick="removeFromCart(${index})" class="text-red-500 hover:text-red-700 text-xs p-1">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            totalElem.innerText = `${totalPrice.toLocaleString()} د.ع`;
        }

        function changeQty(index, delta) {
            cart[index].qty += delta;
            if (cart[index].qty <= 0) {
                cart.splice(index, 1);
            }
            saveCart();
            renderCartItems();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            saveCart();
            renderCartItems();
        }

        // Direct WhatsApp Checkout
        function checkoutWhatsApp() {
            if (cart.length === 0) {
                showToast('سلتك فارغة!');
                return;
            }

            const shopPhone = "9647800000000"; // رقم محلك هنا
            let msg = "مرحباً *متجر الكرادة للإلكترونيات* 🛍️\n";
            msg += "أرغب بحجز الطلبية التالية:\n\n";

            let grandTotal = 0;
            cart.forEach((item, i) => {
                const total = item.price * item.qty;
                grandTotal += total;
                msg += `${i+1}. *${item.title}*\n   العدد: ${item.qty} | السعر: ${total.toLocaleString()} د.ع\n`;
            });

            msg += `\n*المجموع الكلي:* ${grandTotal.toLocaleString()} د.ع\n`;
            msg += "يرجى تأكيد الحجز وتحديد تفاصيل التوصيل.";

            const encoded = encodeURIComponent(msg);
            window.open(`https://wa.me/${shopPhone}?text=${encoded}`, '_blank');
        }

        // Admin Panel CRUD
        function toggleAdminModal() {
            document.getElementById('admin-modal').classList.toggle('hidden');
        }

        function handleAddProduct(event) {
            event.preventDefault();

            const title = document.getElementById('admin-title').value;
            const price = parseInt(document.getElementById('admin-price').value);
            const oldPrice = parseInt(document.getElementById('admin-old-price').value) || null;
            const category = document.getElementById('admin-category').value;
            const brand = document.getElementById('admin-brand').value || 'Original';
            const image = document.getElementById('admin-image').value || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80';

            const newProd = {
                id: Date.now(),
                title,
                category,
                price,
                oldPrice,
                discountText: oldPrice ? `خصم ${(oldPrice - price).toLocaleString()} د.ع` : null,
                brand,
                image
            };

            products.unshift(newProd);
            saveProducts();
            renderProducts();
            renderAdminInventory();

            document.getElementById('add-product-form').reset();
            showToast('تمت إضافة المنتج بنجاح للمتجر!');
        }

        function renderAdminInventory() {
            const container = document.getElementById('admin-products-list');
            container.innerHTML = '';
            products.forEach(p => {
                container.innerHTML += `
                    <div class="flex items-center justify-between bg-white p-2 rounded-xl border border-slate-200 text-xs">
                        <div class="flex items-center gap-2 line-clamp-1 max-w-[200px]">
                            <img src="${p.image}" class="w-8 h-8 object-contain">
                            <span class="font-bold text-slate-800 truncate">${p.title}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-purple-700 font-extrabold">${p.price.toLocaleString()} د.ع</span>
                            <button onclick="deleteProduct(${p.id})" class="text-red-500 font-bold hover:underline">حذف</button>
                        </div>
                    </div>
                `;
            });
        }

        function deleteProduct(id) {
            products = products.filter(p => p.id !== id);
            saveProducts();
            renderProducts();
            renderAdminInventory();
            showToast('تم حذف المنتج من المتجر');
        }

        // Toast Notification Helper
        function showToast(msg) {
            const toast = document.getElementById('toast-msg');
            toast.innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }
    </script>
</body>
</html>