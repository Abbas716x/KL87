                grid.innerHTML += `
                    <div class="bg-white rounded-3xl p-3 border border-slate-100 shadow-sm flex flex-col justify-between relative group hover:shadow-md transition">
                        
                        <!-- Top Badge Discount -->
                        ${product.discountText ? `
                            <span class="absolute top-3 right-3 bg-purple-600 text-white text-[9px] font-black px-2 py-0.5 rounded-full z-10 shadow-sm">
