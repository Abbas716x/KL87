                            </span>
                        ` : ''}

                        <!-- Product Image -->
                        <div class="h-32 w-full rounded-2xl bg-slate-50 overflow-hidden flex items-center justify-center p-2 mb-2">
                            <img src="${product.image}" onerror="this.src='https://via.placeholder.com/200/FAF9FE/6C5CE7?text=Karada+Store'" class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300">
                        </div>

                        <!-- Info -->
                        <div>
                            <h3 class="font-extrabold text-xs text-slate-800 line-clamp-2 leading-snug">${product.title}</h3>
                            
                            <!-- Price & Old Price -->
                            <div class="mt-2 flex items-baseline gap-1.5 flex-wrap">
                                <span class="text-purple-700 font-black text-xs">${product.price.toLocaleString()} د.ع</span>
                                ${product.oldPrice ? `<span class="text-[10px] text-slate-400 line-through font-bold">${product.oldPrice.toLocaleString()}</span>` : ''}
                            </div>

                            <!-- Brand Label -->
                            <div class="mt-2 flex items-center justify-between">
                                <span class="text-[10px] font-bold text-slate-400">${product.brand || 'Original'}</span>
                                <button onclick="addToCart(${product.id})" class="w-8 h-8 rounded-full bg-purple-50 hover:bg-purple-600 hover:text-white text-purple-700 font-bold flex items-center justify-center transition active:scale-90 shadow-sm">
                                    <i class="fa-solid fa-plus text-xs"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                `;
            });
        }

        // Render Brands Grid
        function renderBrands() {
            const container = document.getElementById('brands-grid');
            container.innerHTML = '';
            brandsList.forEach(b => {
                container.innerHTML += `
                    <div class="bg-white p-3 rounded-2xl border border-slate-100 shadow-sm flex flex-col items-center justify-center gap-1.5 hover:border-purple-300 transition">
                        <img src="${b.logo}" onerror="this.src='https://via.placeholder.com/80/ffffff/4834D4?text=${b.name}'" class="w-10 h-10 object-contain">
                        <span class="text-[10px] font-bold text-slate-600 truncate w-full text-center">${b.name}</span>
                    </div>
                `;
            });
        }

        // Render Reels Grid (Discover)
        function renderReels() {
            const container = document.getElementById('reels-grid');
            container.innerHTML = '';
            reelsList.forEach(r => {
                container.innerHTML += `
                    <div class="relative rounded-2xl overflow-hidden h-48 bg-slate-800 shadow-sm group cursor-pointer" onclick="showToast('جاري تشغيل المعاينة...')">
