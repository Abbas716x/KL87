        // Save State
        function saveProducts() {
            localStorage.setItem('karada_products', JSON.stringify(products));
        }
        function saveCart() {
            localStorage.setItem('karada_cart', JSON.stringify(cart));
            updateCartBadge();
        }

        // Initialize App
        window.onload = function() {
            renderProducts();
            renderBrands();
            renderReels();
